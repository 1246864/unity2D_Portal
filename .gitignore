# =============================================================================
# unity2D_Portal — Git 忽略规则
# 工程：Unity 2022.3.61f1c1 / URP 14 / 2D Renderer / Windows
# 依据：github/gitignore Unity 模板 + 本项目目录结构（见 PROJECT.md 第 3 节）
#
# 原则：
#   1. Unity 自动生成的缓存/构建目录不提交，克隆后由编辑器重建；
#   2. Assets 下所有 .meta 必须提交（GUID 稳定，见 PROJECT.md 第 14 节）；
#   3. ProjectSettings/、Packages/manifest.json、packages-lock.json 必须提交；
#   4. 根目录 .vsconfig 是团队 VS 组件清单，必须提交。
# =============================================================================

# -----------------------------------------------------------------------------
# Unity 自动生成目录（可随时由编辑器重建，绝不提交）
# -----------------------------------------------------------------------------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
ExportedObj/
.consulo/
.gradle/

# -----------------------------------------------------------------------------
# 资源 .meta
# -----------------------------------------------------------------------------
# Assets 下所有 .meta 一律入库；此反向规则用于防止上层通配规则误伤
!/[Aa]ssets/**/*.meta
# Unity 自动生成的调试符号 meta（不是资源描述文件）
*.pidb.meta
*.pdb.meta
*.mdb.meta
# Asset Store 工具与 JetBrains 自动生成的插件目录
/[Aa]ssets/AssetStoreTools*
/[Aa]ssets/Plugins/Editor/JetBrains*

# -----------------------------------------------------------------------------
# IDE / 编辑器生成文件（Unity 每次刷新都会重新生成，不入库）
# -----------------------------------------------------------------------------
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.DotSettings.user
.vs/
.vscode/
.idea/
.history/

# -----------------------------------------------------------------------------
# 构建产物
# -----------------------------------------------------------------------------
*.apk
*.aab
*.app
*.unitypackage

# -----------------------------------------------------------------------------
# 测试 / 日志
# 本项目 PlayMode 测试结果输出到 Logs\TestResults.xml（见 PROJECT.md 第 11 节）
# -----------------------------------------------------------------------------
Logs/
TestResults*.xml
*.log

# -----------------------------------------------------------------------------
# 崩溃 / 诊断报告
# -----------------------------------------------------------------------------
sysinfo.txt
*.stackdump
crashlytics-build.properties

# -----------------------------------------------------------------------------
# Addressables / Android 自动生成内容
# -----------------------------------------------------------------------------
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# -----------------------------------------------------------------------------
# 本项目工具脚本缓存
# Tools/generate_placeholders.py 本身需要入库，仅忽略其运行产物
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
_tpl/

# -----------------------------------------------------------------------------
# 操作系统 / 临时补丁文件
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.orig
*.rej
~$*
